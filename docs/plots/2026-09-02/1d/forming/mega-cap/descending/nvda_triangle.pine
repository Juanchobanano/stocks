//@version=5
// NVDA — Descending Triangle △  (LONG (bullish) setup)
// Pattern:  flat floor B→D, falling ceiling A→C
// Status:   FORMING
// Direction: LONG
indicator("NVDA Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 2, 0, 0)
tB = timestamp(2026, 6, 29, 0, 0)
tC = timestamp(2026, 7, 22, 0, 0)
tD = timestamp(2026, 7, 29, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 232.01
pB = 189.80
pC = 214.39
pD = 190.01
pF = 190.01

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 208.69
pLowerEnd = 190.07

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(255.04, "TP full  +19.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(233.84, "TP half  +10.0%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(212.65, "Entry  212.65",    color.white,             hline.style_solid,  4)
hline(189.59, "Stop  -10.8%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 255.04, "TP full  255.04  (+19.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 233.84, "TP half  233.84  (+10.0%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 212.65, "Entry L  212.65", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 189.59, "Stop L  189.59  (-10.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
