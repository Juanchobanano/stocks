//@version=5
// BCH-USD — Ascending Triangle △  (SHORT (bearish) setup)
// Pattern:  flat top A→C, rising floor B→D
// Status:   COMPLETED
// Direction: SHORT
indicator("BCH-USD Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 8, 2, 0, 0)
tB = timestamp(2026, 8, 3, 0, 0)
tC = timestamp(2026, 8, 3, 0, 0)
tD = timestamp(2026, 8, 4, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 214.65
pB = 208.29
pC = 215.20
pD = 211.20
pF = 213.86

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 217.32
pLowerEnd = 224.11

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(203.59, "TP full  +3.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(207.67, "TP half  +1.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(211.76, "Entry  211.76",    color.white,             hline.style_solid,  4)
hline(215.56, "Stop  -1.8%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 215.56 * 1.025, "Stop L  215.56  (-1.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 211.76 * 1.025, "Entry L  211.76", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 207.67 * 1.025, "TP half  207.67  (+1.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 203.59 * 0.970, "TP full  203.59  (+3.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
