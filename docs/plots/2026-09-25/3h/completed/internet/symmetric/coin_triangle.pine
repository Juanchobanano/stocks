//@version=5
// COIN — Symmetric Triangle △  (SYMMETRIC (both) setup)
// Pattern:  converging lines A→C and B→D
// Status:   COMPLETED
// Direction: SYMMETRIC
indicator("COIN Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 15, 0, 0)
tB = timestamp(2026, 6, 26, 0, 0)
tC = timestamp(2026, 7, 2, 0, 0)
tD = timestamp(2026, 7, 9, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 174.44
pB = 139.18
pC = 173.07
pD = 154.78
pF = 159.29

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 170.25
pLowerEnd = 195.08

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(224.38, "TP full  +29.3%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(198.95, "TP half  +14.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(173.52, "Entry  173.52",    color.white,             hline.style_solid,  4)
hline(156.22, "Stop  -10.0%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── SHORT trade levels ────────────────────────────────────────
hline(104.85, "TP full S  +32.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(130.28, "TP half S  +16.3%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(155.71, "Entry S  155.71",    color.white,             hline.style_solid,  4)
hline(173.01, "Stop S  -11.1%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 224.38, "TP full  224.38  (+29.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 198.95, "TP half  198.95  (+14.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 173.52 * 1.025, "Entry L  173.52", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 156.22 * 1.025, "Stop L  156.22  (-10.0%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 173.01 * 0.970, "Stop S  173.01  (-11.1%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 155.71 * 0.970, "Entry S  155.71", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 130.28, "TP half S  130.28  (+16.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 104.85, "TP full S  104.85  (+32.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
