//@version=5
// COIN — Ascending Triangle △  (SHORT (bearish) setup)
// Pattern:  flat top A→C, rising floor B→D
// Status:   COMPLETED
// Direction: SHORT
indicator("COIN Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 3, 5, 0, 0)
tB = timestamp(2026, 3, 30, 0, 0)
tC = timestamp(2026, 4, 17, 0, 0)
tD = timestamp(2026, 4, 29, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 213.50
pB = 158.46
pC = 216.05
pD = 177.62
pF = 212.01

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 222.51
pLowerEnd = 239.66

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(115.69, "TP full  +37.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(150.97, "TP half  +18.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(186.25, "Entry  186.25",    color.white,             hline.style_solid,  4)
hline(218.37, "Stop  -17.2%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 218.37, "Stop L  218.37  (-17.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 186.25, "Entry L  186.25", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 150.97, "TP half  150.97  (+18.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 115.69, "TP full  115.69  (+37.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
