//@version=5
// SOL-USD — Symmetric Triangle △  (SYMMETRIC (both) setup)
// Pattern:  converging lines A→C and B→D
// Status:   FORMING
// Direction: SYMMETRIC
indicator("SOL-USD Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 5, 11, 0, 0)
tB = timestamp(2026, 6, 6, 0, 0)
tC = timestamp(2026, 7, 4, 0, 0)
tD = timestamp(2026, 7, 17, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 98.27
pB = 60.41
pC = 83.81
pD = 73.40
pF = 75.01

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 74.97
pLowerEnd = 79.74

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(127.34, "TP full  +56.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(104.29, "TP half  +28.4%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(81.25, "Entry  81.25",    color.white,             hline.style_solid,  4)
hline(72.94, "Stop  -10.2%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── SHORT trade levels ────────────────────────────────────────
hline(26.39, "TP full S  +63.6%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(49.44, "TP half S  +31.8%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(72.48, "Entry S  72.48",    color.white,             hline.style_solid,  4)
hline(80.79, "Stop S  -11.5%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 127.34, "TP full  127.34  (+56.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 104.29, "TP half  104.29  (+28.4%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 81.25 * 1.025, "Entry L  81.25", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 72.94 * 1.025, "Stop L  72.94  (-10.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 80.79 * 0.970, "Stop S  80.79  (-11.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 72.48 * 0.970, "Entry S  72.48", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 49.44, "TP half S  49.44  (+31.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 26.39, "TP full S  26.39  (+63.6%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
