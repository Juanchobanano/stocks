//@version=5
// MPWR — Ascending Triangle △  (SHORT (bearish) setup)
// Pattern:  flat top A→C, rising floor B→D
// Status:   COMPLETED
// Direction: SHORT
indicator("MPWR Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 30, 0, 0)
tB = timestamp(2026, 7, 7, 0, 0)
tC = timestamp(2026, 7, 9, 0, 0)
tD = timestamp(2026, 7, 13, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 1388.53
pB = 1232.04
pC = 1407.09
pD = 1277.64
pF = 1315.43

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 1479.01
pLowerEnd = 1470.58

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(1099.77, "TP full  +14.8%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(1195.56, "TP half  +7.4%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(1291.35, "Entry  1291.35",    color.white,             hline.style_solid,  4)
hline(1422.93, "Stop  -10.2%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 1422.93, "Stop L  1422.93  (-10.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 1291.35, "Entry L  1291.35", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 1195.56, "TP half  1195.56  (+7.4%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 1099.77, "TP full  1099.77  (+14.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
