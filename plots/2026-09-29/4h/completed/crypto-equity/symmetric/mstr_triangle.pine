//@version=5
// MSTR — Symmetric Triangle △  (SYMMETRIC (both) setup)
// Pattern:  converging lines A→C and B→D
// Status:   COMPLETED
// Direction: SYMMETRIC
indicator("MSTR Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 15, 0, 0)
tB = timestamp(2026, 6, 26, 0, 0)
tC = timestamp(2026, 7, 21, 0, 0)
tD = timestamp(2026, 7, 24, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 136.25
pB = 81.81
pC = 104.60
pD = 89.76
pF = 93.32

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 88.12
pLowerEnd = 93.84

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(155.28, "TP full  +59.8%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(126.24, "TP half  +29.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(97.19, "Entry  97.19",    color.white,             hline.style_solid,  4)
hline(90.68, "Stop  -6.7%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── SHORT trade levels ────────────────────────────────────────
hline(32.01, "TP full S  +64.5%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(61.06, "TP half S  +32.2%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(90.10, "Entry S  90.10",    color.white,             hline.style_solid,  4)
hline(96.61, "Stop S  -7.2%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 155.28, "TP full  155.28  (+59.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 126.24, "TP half  126.24  (+29.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 97.19 * 1.025, "Entry L  97.19", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 90.68 * 1.025, "Stop L  90.68  (-6.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 96.61 * 0.970, "Stop S  96.61  (-7.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 90.10 * 0.970, "Entry S  90.10", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 61.06, "TP half S  61.06  (+32.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 32.01, "TP full S  32.01  (+64.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
