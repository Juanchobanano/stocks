//@version=5
// ETH-USD — Ascending Triangle △  (SHORT (bearish) setup)
// Pattern:  flat top A→C, rising floor B→D
// Status:   COMPLETED
// Direction: SHORT
indicator("ETH-USD Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 7, 15, 0, 0)
tB = timestamp(2026, 7, 17, 0, 0)
tC = timestamp(2026, 7, 22, 0, 0)
tD = timestamp(2026, 7, 24, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 1944.30
pB = 1802.35
pC = 1955.81
pD = 1846.59
pF = 1925.44

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 1980.17
pLowerEnd = 1930.86

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(1707.87, "TP full  +8.3%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(1785.16, "TP half  +4.2%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(1862.46, "Entry  1862.46",    color.white,             hline.style_solid,  4)
hline(1965.12, "Stop  -5.5%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 1965.12, "Stop L  1965.12  (-5.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 1862.46, "Entry L  1862.46", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 1785.16, "TP half  1785.16  (+4.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 1707.87, "TP full  1707.87  (+8.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
