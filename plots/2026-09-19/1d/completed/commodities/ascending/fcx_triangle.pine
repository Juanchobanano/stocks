//@version=5
// FCX — Ascending Triangle △  (SHORT (bearish) setup)
// Pattern:  flat top A→C, rising floor B→D
// Status:   COMPLETED
// Direction: SHORT
indicator("FCX Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 4, 20, 0, 0)
tB = timestamp(2026, 5, 4, 0, 0)
tC = timestamp(2026, 6, 2, 0, 0)
tD = timestamp(2026, 6, 10, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 70.80
pB = 55.36
pC = 71.92
pD = 61.58
pF = 68.89

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 73.59
pLowerEnd = 70.92

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(44.58, "TP full  +28.6%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(53.50, "TP half  +14.3%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(62.42, "Entry  62.42",    color.white,             hline.style_solid,  4)
hline(72.50, "Stop  -16.1%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 72.50, "Stop L  72.50  (-16.1%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 62.42, "Entry L  62.42", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 53.50, "TP half  53.50  (+14.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 44.58, "TP full  44.58  (+28.6%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
