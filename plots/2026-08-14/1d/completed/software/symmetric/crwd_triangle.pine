//@version=5
// CRWD — Symmetric Triangle △  (SYMMETRIC (both) setup)
// Pattern:  converging lines A→C and B→D
// Status:   COMPLETED
// Direction: SYMMETRIC
indicator("CRWD Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 1, 27, 0, 0)
tB = timestamp(2026, 2, 23, 0, 0)
tC = timestamp(2026, 3, 11, 0, 0)
tD = timestamp(2026, 3, 27, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 121.80
pB = 85.68
pC = 113.00
pD = 90.45
pF = 106.63

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 83.08
pLowerEnd = 108.35

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(147.92, "TP full  +36.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(128.07, "TP half  +18.3%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(108.22, "Entry  108.22",    color.white,             hline.style_solid,  4)
hline(91.45, "Stop  -15.5%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── SHORT trade levels ────────────────────────────────────────
hline(51.35, "TP full S  +43.6%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(71.20, "TP half S  +21.8%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(91.05, "Entry S  91.05",    color.white,             hline.style_solid,  4)
hline(107.82, "Stop S  -18.4%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 147.92, "TP full  147.92  (+36.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 128.07, "TP half  128.07  (+18.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 108.22 * 1.025, "Entry L  108.22", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 91.45 * 1.025, "Stop L  91.45  (-15.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 107.82 * 0.970, "Stop S  107.82  (-18.4%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 91.05 * 0.970, "Entry S  91.05", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 71.20, "TP half S  71.20  (+21.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 51.35, "TP full S  51.35  (+43.6%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
