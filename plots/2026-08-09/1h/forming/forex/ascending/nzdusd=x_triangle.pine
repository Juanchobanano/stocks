//@version=5
// NZDUSD=X — Ascending Triangle △  (SHORT (bearish) setup)
// Pattern:  flat top A→C, rising floor B→D
// Status:   FORMING
// Direction: SHORT
indicator("NZDUSD=X Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 8, 4, 0, 0)
tB = timestamp(2026, 8, 5, 0, 0)
tC = timestamp(2026, 8, 6, 0, 0)
tD = timestamp(2026, 8, 6, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 0.59
pB = 0.59
pC = 0.59
pD = 0.59
pF = 0.59

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 0.59
pLowerEnd = 0.59

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(0.58, "TP full  +1.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(0.58, "TP half  +1.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(0.59, "Entry  0.59",    color.white,             hline.style_solid,  4)
hline(0.59, "Stop  -0.0%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 0.59 * 1.025, "Entry L  0.59", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 0.59 * 1.025, "Stop L  0.59  (-0.0%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 0.58 * 0.970, "TP full  0.58  (+1.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 0.58 * 1.025, "TP half  0.58  (+1.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
