//@version=5
// IRDM — Descending Triangle △  (LONG (bullish) setup)
// Pattern:  flat floor B→D, falling ceiling A→C
// Status:   COMPLETED
// Direction: LONG
indicator("IRDM Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 7, 13, 0, 0)
tB = timestamp(2026, 7, 17, 0, 0)
tC = timestamp(2026, 7, 22, 0, 0)
tD = timestamp(2026, 7, 23, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 50.69
pB = 45.78
pC = 48.40
pD = 46.20
pF = 47.68

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 44.64
pLowerEnd = 47.28

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(53.27, "TP full  +11.1%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(50.61, "TP half  +5.5%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(47.96, "Entry  47.96",    color.white,             hline.style_solid,  4)
hline(46.22, "Stop  -3.6%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 53.27, "TP full  53.27  (+11.1%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 50.61, "TP half  50.61  (+5.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 47.96, "Entry L  47.96", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 46.22, "Stop L  46.22  (-3.6%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
