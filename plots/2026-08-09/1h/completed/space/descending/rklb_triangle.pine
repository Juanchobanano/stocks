//@version=5
// RKLB — Descending Triangle △  (LONG (bullish) setup)
// Pattern:  flat floor B→D, falling ceiling A→C
// Status:   COMPLETED
// Direction: LONG
indicator("RKLB Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 9, 0, 0)
tB = timestamp(2026, 6, 9, 0, 0)
tC = timestamp(2026, 6, 12, 0, 0)
tD = timestamp(2026, 6, 12, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 119.79
pB = 101.20
pC = 118.00
pD = 99.61
pF = 109.90

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 95.48
pLowerEnd = 78.70

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(135.96, "TP full  +15.6%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(126.78, "TP half  +7.8%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(117.61, "Entry  117.61",    color.white,             hline.style_solid,  4)
hline(98.87, "Stop  -15.9%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 135.96, "TP full  135.96  (+15.6%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 126.78, "TP half  126.78  (+7.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 117.61, "Entry L  117.61", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 98.87, "Stop L  98.87  (-15.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
