//@version=5
// COIN — Symmetric Triangle △  (SYMMETRIC (both) setup)
// Pattern:  converging lines A→C and B→D
// Status:   COMPLETED
// Direction: SYMMETRIC
indicator("COIN Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 22, 0, 0)
tB = timestamp(2026, 6, 26, 0, 0)
tC = timestamp(2026, 7, 6, 0, 0)
tD = timestamp(2026, 7, 9, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 176.48
pB = 139.18
pC = 171.67
pD = 154.78
pF = 162.13

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 159.72
pLowerEnd = 195.45

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(215.85, "TP full  +26.4%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(193.30, "TP half  +13.2%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(170.75, "Entry  170.75",    color.white,             hline.style_solid,  4)
hline(156.28, "Stop  -8.5%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── SHORT trade levels ────────────────────────────────────────
hline(110.73, "TP full S  +28.9%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(133.28, "TP half S  +14.5%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(155.83, "Entry S  155.83",    color.white,             hline.style_solid,  4)
hline(170.30, "Stop S  -9.3%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 215.85, "TP full  215.85  (+26.4%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 193.30, "TP half  193.30  (+13.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 170.75 * 1.025, "Entry L  170.75", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 156.28 * 1.025, "Stop L  156.28  (-8.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 170.30 * 0.970, "Stop S  170.30  (-9.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 155.83 * 0.970, "Entry S  155.83", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 133.28, "TP half S  133.28  (+14.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 110.73, "TP full S  110.73  (+28.9%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
