//@version=5
// ANET — Descending Triangle △  (LONG (bullish) setup)
// Pattern:  flat floor B→D, falling ceiling A→C
// Status:   COMPLETED
// Direction: LONG
indicator("ANET Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 7, 13, 0, 0)
tB = timestamp(2026, 7, 17, 0, 0)
tC = timestamp(2026, 7, 23, 0, 0)
tD = timestamp(2026, 7, 29, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 189.56
pB = 157.13
pC = 179.48
pD = 156.84
pF = 168.94

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 165.55
pLowerEnd = 156.61

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(205.82, "TP full  +18.6%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(189.68, "TP half  +9.3%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(173.53, "Entry  173.53",    color.white,             hline.style_solid,  4)
hline(156.49, "Stop  -9.8%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 205.82, "TP full  205.82  (+18.6%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 189.68, "TP half  189.68  (+9.3%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 173.53, "Entry L  173.53", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 156.49, "Stop L  156.49  (-9.8%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
