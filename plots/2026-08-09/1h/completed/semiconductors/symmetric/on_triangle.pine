//@version=5
// ON — Symmetric Triangle △  (SYMMETRIC (both) setup)
// Pattern:  converging lines A→C and B→D
// Status:   COMPLETED
// Direction: SYMMETRIC
indicator("ON Triangle", overlay=true, max_lines_count=500, max_labels_count=500)

// ── Pivot timestamps ──────────────────────────────────────────
tA = timestamp(2026, 6, 25, 0, 0)
tB = timestamp(2026, 6, 29, 0, 0)
tC = timestamp(2026, 7, 9, 0, 0)
tD = timestamp(2026, 7, 13, 0, 0)

// ── Pivot prices ──────────────────────────────────────────────
pA = 121.25
pB = 86.47
pC = 102.64
pD = 90.09
pF = 92.80

// ── Trendline endpoints at current bar ────────────────────────
pUpperEnd = 57.67
pLowerEnd = 96.85

// ── TRENDLINES — from first pivot to current bar ──────────────
if barstate.islast
    // Upper: first high → current bar
    line.new(tA, pA, last_bar_time, pUpperEnd, xloc=xloc.bar_time,
             color=color.white, width=4)
    // Lower: first low → current bar
    line.new(tB, pB, last_bar_time, pLowerEnd, xloc=xloc.bar_time,
             color=color.new(#ffff00, 0), width=4)

// ── HORIZONTAL TRADE LEVELS ───────────────────────────────────
hline(132.46, "TP full  +36.4%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(114.80, "TP half  +18.2%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(97.14, "Entry  97.14",    color.white,             hline.style_solid,  4)
hline(89.84, "Stop  -7.5%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── SHORT trade levels ────────────────────────────────────────
hline(54.18, "TP full S  +39.5%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(71.83, "TP half S  +19.7%",  color.new(#ffff00, 20), hline.style_dashed, 4)
hline(89.49, "Entry S  89.49",    color.white,             hline.style_solid,  4)
hline(96.79, "Stop S  -8.2%",     color.new(#ffff00, 20),  hline.style_dashed, 4)

// ── POINT LABELS ───────────────────────────────────────────────
if barstate.islast
    c = color.new(color.white, 80)
    // Highs — label below
    label.new(tA, pA, "A", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    label.new(tC, pC, "C", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_down, size=size.normal)
    // Lows — label above
    label.new(tB, pB, "B", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "D", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pD, "E", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)
    label.new(tD, pF, "F", xloc=xloc.bar_time, color=c, textcolor=color.white, style=label.style_label_up,   size=size.normal)

// ── RIGHT-EDGE LEVEL LABELS ────────────────────────────────────
if barstate.islast
    label.new(bar_index + 2, 132.46, "TP full  132.46  (+36.4%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 114.80, "TP half  114.80  (+18.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 97.14 * 1.025, "Entry L  97.14", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 2, 89.84 * 1.025, "Stop L  89.84  (-7.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 96.79 * 0.970, "Stop S  96.79  (-8.2%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 89.49 * 0.970, "Entry S  89.49", color=color.new(color.white, 90), textcolor=color.new(color.white, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 71.83, "TP half S  71.83  (+19.7%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
    label.new(bar_index + 10, 54.18, "TP full S  54.18  (+39.5%)", color=color.new(#ffff00, 90), textcolor=color.new(#ffff00, 0), style=label.style_none, size=size.large)
